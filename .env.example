# Cấu hình MinIO Console cho Log Viewer
# Copy file này thành .env và điền thông tin hệ thống của bạn:
MINIO_URL=https://minio.example.com/browser/your-log-bucket
MINIO_USERNAME=your_username
MINIO_PASSWORD=your_password

# (Tuỳ chọn) Tên bucket mặc định nếu URL không chứa tên bucket
# MINIO_BUCKET=your-log-bucket

# (Tuỳ chọn) Thư mục lưu trữ log tuỳ chỉnh
# MINIO_STORAGE_DIR=D:\LogViewerData
